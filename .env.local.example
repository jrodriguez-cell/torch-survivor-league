# Copy to .env.local (local dev). In production these live in Vercel's
# Environment Variables. The Vercel Supabase integration provides the URL +
# anon key automatically (the app reads several possible names).

# Public — safe in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC. Used by the cron/admin routes.
# Supabase dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Secret that authenticates Vercel Cron -> /api/cron/* routes. Any long random
# string; set the same value in Vercel.
CRON_SECRET=

# Optional (Phase 6 email). Without these, notification emails are a no-op.
# Get a key at resend.com. EMAIL_FROM must be a verified sender once you leave
# Resend's test mode.
RESEND_API_KEY=
EMAIL_FROM=Last Team Standing <survivor@yourdomain.com>

# Optional (AI-written weekly recap). Without it, recaps use a plain template.
# Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
