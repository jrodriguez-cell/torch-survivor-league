# Copy this file to .env.local and fill in with your Supabase project values.
# Find these in your Supabase dashboard: Project Settings -> API

# The project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The base URL of this app, used for magic-link redirects.
# Local dev: http://localhost:3000  |  Production: your deployed URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
